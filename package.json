{
	"name": "obsidian-clew",
	"version": "1.2.0",
	"description": "See your whole vault as a graph and find how any two notes connect, without every path routing through your index notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run test && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && npm run test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:perf": "vitest run --config vitest.perf.config.ts",
		"release": "bash release.sh",
		"release:publish": "bash release.sh --publish",
		"release:patch": "bash release.sh --bump patch --publish",
		"release:minor": "bash release.sh --bump minor --publish",
		"release:major": "bash release.sh --bump major --publish",
		"spike:build": "node spike/esbuild.mjs",
		"gen-test-vault": "node scripts/gen-test-vault.mjs",
		"gen-history-vault": "node scripts/gen-history-vault.mjs",
		"sync-private-vault": "bash scripts/sync-private-vault.sh",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:shots": "node scripts/screenshots.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"overrides": {
		"vite": "^6.4.3",
		"fast-uri": "^3.1.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"playwright-core": "^1.62.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@sigma/node-image": "^3.0.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"graphology-layout-forceatlas2": "^0.10.1",
		"graphology-shortest-path": "^2.1.0",
		"sigma": "^3.0.3"
	}
}
