# vscode
.vscode

# Claude Code local tooling config
.claude

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local release staging (assets are uploaded to GitHub releases instead)
releases/

# Spike harness build output (source lives in spike/, this is generated)
spike/dist/

# Generated spike test vault (scripts/gen-graph-vault.mjs) - never lands in git
spike-vault/
spike-vault.zip

# Generated manual-QA test vault (scripts/gen-test-vault.mjs) - regenerated
# on demand, and mtimes are baked in at generation time, so it couldn't be
# meaningfully committed anyway.
test-vault/

# Test coverage (vitest --coverage)
coverage/

# VitePress build output/cache (docs/) - deployed by CI, not committed.
docs/.vitepress/dist
docs/.vitepress/cache

# Scratch vault the screenshot script (scripts/screenshots.mjs) builds and
# tears down - like test-vault/, never meant to be committed.
.screenshot-vault/
